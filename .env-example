# ==============================================================================
# NeonHop 3D - API Key Configuration Template
# ==============================================================================
# Copy this file to `.env` in the root workspace directory:
#   cp .env-example .env
#
# IMPORTANT: Never commit or publish your actual `.env` file!
# It is excluded by `.gitignore` to protect your secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIMARY: TypeSafe AI Direct API Key (Preferred)
# ------------------------------------------------------------------------------
# If provided, NeonHop 3D routes requests directly to TypeSafe AI:
# Endpoint: https://api.typesafe.ai/v1/systemone
# Model: jev-latest
#
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# ------------------------------------------------------------------------------
# SECONDARY / FALLBACK: OpenRouter.ai API Key
# ------------------------------------------------------------------------------
# If TYPESAFE_API_KEY is not set, NeonHop 3D falls back to OpenRouter:
# Endpoint: https://openrouter.ai/api/alpha/decisions
# Model: typesafe/jev-1.13
#
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# SERVER PORT (Optional, Default: 8000)
# ------------------------------------------------------------------------------
PORT=8000
